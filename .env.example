# Ruff configuration. Everything is read from the environment (twelve-factor
# III); this file is a template for local development (`cp .env.example .env`,
# loaded by run.py, alembic and compose). On a platform, set real environment
# variables instead and never commit a .env file.

# --- Required in production -------------------------------------------------
FLASK_ENV=production
# Random, at least 32 characters each:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SECURITY_PASSWORD_SALT=

# --- Backing services (attached resources, named by URL) --------------------
# SQLite file, or PostgreSQL: postgres://user:pass@host:5432/db
DATABASE_URL=sqlite:///./ruff.db
# memory:// for a single process; redis://host:6379/0 when running several
# processes or containers, so they share rate-limit counters.
RATELIMIT_STORAGE_URL=memory://
# Nearby Share across several processes or containers: redis://host:6379/1
SOCKETIO_MESSAGE_QUEUE=
# Outgoing email (verification and password reset links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
# Error alerting (optional)
SENTRY_DSN=

# --- Web process --------------------------------------------------------------
# Port to listen on (the platform usually sets this)
PORT=8000
# Processes and threads per container (keep 1 worker: Socket.IO needs it)
WEB_CONCURRENCY=1
GUNICORN_THREADS=100
# Run `alembic upgrade head` when the container starts. Set 0 when a separate
# release step runs migrations (Procfile release, compose "release" service).
RUN_MIGRATIONS=1

# --- Logs (stdout only) ---------------------------------------------------------
# json (one object per line) or console; level DEBUG/INFO/WARNING/ERROR
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Security and behaviour -------------------------------------------------------
SESSION_COOKIE_SECURE=1
REQUIRE_EMAIL_VERIFICATION=1
EMAIL_VERIFY_TOKEN_EXP=86400
PASSWORD_RESET_TOKEN_EXP=3600
# Reverse proxies in front of the app that set X-Forwarded-* headers
# (1 on Heroku/Render/behind nginx; 0 when clients connect directly).
PROXY_FIX_COUNT=0
# Largest accepted request body in bytes (backups). Default 16 MB.
MAX_CONTENT_LENGTH=16777216
# Extra origins allowed to open Socket.IO connections, comma-separated.
SOCKETIO_CORS_ORIGINS=
# Days before Recess Relay sessions are deleted (also: flask purge-relays)
RELAY_RETENTION_DAYS=30
# Product name shown in the UI
APP_NAME=Ruff
