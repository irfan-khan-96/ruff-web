# Required
FLASK_ENV=production
SECRET_KEY=
SECURITY_PASSWORD_SALT=
DATABASE_URL=sqlite:///./ruff.db
SESSION_COOKIE_SECURE=1
REQUIRE_EMAIL_VERIFICATION=1
# memory:// is fine for a single app process. Use redis://host:6379/0 when
# running several processes or instances so they share rate-limit counters.
RATELIMIT_STORAGE_URL=memory://
EMAIL_VERIFY_TOKEN_EXP=86400
PASSWORD_RESET_TOKEN_EXP=3600
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# Reverse proxies in front of the app that set X-Forwarded-* headers
# (1 on Heroku/Render/behind nginx; 0 when clients connect directly).
# Wrong values let clients spoof their IP or make all users share one.
PROXY_FIX_COUNT=0

# Largest accepted request body in bytes (imports, uploads). Default 16 MB.
MAX_CONTENT_LENGTH=16777216

# Extra origins allowed to open Socket.IO connections, comma-separated.
# Empty = same origin only.
SOCKETIO_CORS_ORIGINS=

# Optional
SENTRY_DSN=
REDIS_URL=
FLASK_DEBUG=0
